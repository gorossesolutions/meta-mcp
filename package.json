{
  "name": "meta-ads-mcp",
  "version": "0.1.0",
  "description": "Self-hosted MCP server exposing the Meta Marketing API (Facebook/Instagram Ads) to Claude — read and manage ad accounts, campaigns, ad sets, ads, creatives and insights.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "meta-ads-mcp": "dist/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src db",
    "test:manual": "tsx test/manual-check.ts",
    "db:migrate": "tsx db/migrate.ts"
  },
  "license": "UNLICENSED",
  "private": true,
  "author": "Guillaume (GR AdLab)",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
