# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Vite's default scaffold gitignore does NOT cover plain .env (only
# *.local) — added explicitly. Not that this project ever puts a secret
# here (Data API/Auth URLs are public by design, see .env.example), but a
# future contributor could paste something sensitive without realizing.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
