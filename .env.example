# Meta App credentials (developers.facebook.com > My Apps)
META_APP_ID=
META_APP_SECRET=

# Long-lived user token OR System User token (Business Manager > System Users)
META_ACCESS_TOKEN=

# Business Manager ID
META_BUSINESS_ID=

# Graph API version to target
META_API_VERSION=v26.0

# Path to multi-account mapping file (client_id -> ad_account_id / token)
# See accounts.config.json.example for the expected shape.
ACCOUNTS_CONFIG_PATH=./accounts.config.json

# Guardrail: block silent execution of budget changes above this % delta
# without an explicit confirmation step (see README > Security rules)
BUDGET_CHANGE_CONFIRMATION_THRESHOLD_PERCENT=20

# Neon Postgres — used by `npm run db:migrate` and (later) the sync job.
# This must be the project OWNER connection string (e.g. neondb_owner):
# migrations create roles/policies, which requires elevated privileges.
# Get it from the Neon console > your project > Connection Details.
# Never use the pooled ("-pooler") connection string here — migrations need
# a single persistent session for transactions (BEGIN/COMMIT across
# statements), which connection pooling can break.
DATABASE_URL=

# svc_sync role connection string — same host/db as DATABASE_URL, but as the
# svc_sync role created by db/migrations/0008_rls.sql. Used by `npm run
# db:sync` — set this once you've also set svc_sync's password manually
# (see db/README.md; this password is intentionally never in a committed
# migration file). The sync job refuses to start if this isn't set, and
# refuses to run if the role it actually connects as isn't svc_sync — see
# db/sync/guard.ts.
DATABASE_URL_SYNC=

# Proactive Meta rate-limit throttling (db/sync and any future MCP usage
# under volume) — reads the X-Business-Use-Case-Usage response header and
# sleeps before the next call once usage crosses this threshold, instead of
# waiting to get rejected.
META_RATE_LIMIT_THROTTLE_THRESHOLD_PERCENT=80
META_RATE_LIMIT_THROTTLE_DELAY_MS=3000

# Optional: parses the ad name to auto-populate creative_angles (category,
# label, hook, format) during sync. A JS regex with named capture groups
# (?<category>...), (?<label>...), (?<hook>...), (?<format>...) — only
# `label` is required for a row to be created; unmatched groups stay null.
# Leave unset to disable automatic angle parsing entirely (rows then stay
# available for manual tagging via the future UI, per db/README.md).
AD_NAME_ANGLE_PATTERN=
